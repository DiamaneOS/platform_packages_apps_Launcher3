<!-- Home settings entries of DiamaneOS Tally. SettingsActivity adds them after
     launcher_preferences.xml, which res-stock replaces with Pixel's. -->
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- DiamaneOS Tally: Home's tallies band and search slot, which come off Home as a widget
         does and come back here (keys as TallyHomeItem's). Their switches follow the settings
         while open, as Home changes them too. -->
    <com.android.launcher3.tally.home.TallyHomeItemSwitch
        android:key="pref_tally_home_tallies"
        android:title="@string/tally_home_tallies"
        android:summary="@string/tally_home_tallies_summary"
        android:defaultValue="true"
        android:persistent="true" />

    <com.android.launcher3.tally.home.TallyHomeItemSwitch
        android:key="pref_tally_home_search"
        android:title="@android:string/search_go"
        android:summary="@string/tally_home_search_summary"
        android:defaultValue="true"
        android:persistent="true" />

    <!-- DiamaneOS Tally: the "Suggestions" row of Home's search, off by default. Turning it off
         deletes what Home counted. Keys as in TallyFrequentStore. -->
    <com.android.launcher3.tally.search.TallyFrequentSwitch
        android:key="pref_tally_search_frequent"
        android:title="@string/suggested_widgets_header_title"
        android:summary="@string/tally_frequent_summary"
        android:defaultValue="false"
        android:persistent="true" />

    <SwitchPreference
        android:key="pref_tally_search_frequent_dock"
        android:title="@string/tally_frequent_dock"
        android:summary="@string/tally_frequent_dock_summary"
        android:defaultValue="true"
        android:dependency="pref_tally_search_frequent"
        android:persistent="true" />

    <com.android.launcher3.tally.search.TallyFrequentUnhide
        android:key="pref_tally_search_frequent_unhide"
        android:title="@string/tally_frequent_unhide"
        android:persistent="false" />

    <com.android.launcher3.tally.search.TallyFrequentClear
        android:key="pref_tally_search_frequent_clear"
        android:title="@string/tally_frequent_clear"
        android:summary="@string/tally_frequent_clear_summary"
        android:dependency="pref_tally_search_frequent"
        android:persistent="false" />

    <!-- DiamaneOS Tally: a double tap on empty Home turns the screen off, off by default. Key
         as in TallyDoubleTapSleep. -->
    <SwitchPreference
        android:key="pref_tally_double_tap_sleep"
        android:title="@string/tally_double_tap_sleep"
        android:summary="@string/tally_double_tap_sleep_summary"
        android:defaultValue="false"
        android:persistent="true" />

</androidx.preference.PreferenceScreen>
