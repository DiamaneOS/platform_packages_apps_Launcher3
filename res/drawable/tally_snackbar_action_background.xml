<!-- DiamaneOS Tally: the snackbar's action key (Undo), pressed in its own 8 dp key shape, as the
     prototype's Undo key. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/tally_snackbar_action_press">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/tally_radius_s" />
        </shape>
    </item>
</ripple>
