<!-- DiamaneOS Tally: a shortcut's "Add to home screen" key in an app's long-press menu, a Tally
     key instead of stock's filled circle (circles mean state): 32 dp, 8 dp corners, in the surface
     high tone as the prototype's tonal key, with Material's add glyph (20 dp) in ink. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="32"
    android:viewportHeight="32">
    <path
        android:fillColor="@color/tally_surface_high"
        android:pathData="M8,0L24,0A8,8 0,0 1,32 8L32,24A8,8 0,0 1,24 32L8,32A8,8 0,0 1,0 24L0,8A8,8 0,0 1,8 0Z" />
    <group
        android:scaleX="0.0208333"
        android:scaleY="0.0208333"
        android:translateX="6"
        android:translateY="6">
        <path
            android:fillColor="@color/tally_ink"
            android:pathData="M440,520L200,520L200,440L440,440L440,200L520,200L520,440L760,440L760,520L520,520L520,760L440,760Z" />
    </group>
</vector>
