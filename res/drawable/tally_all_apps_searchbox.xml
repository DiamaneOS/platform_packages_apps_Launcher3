<!-- DiamaneOS Tally: All apps' search field, as the prototype's: a field, not a pill (r12, the
     surface colour, a 1 dp outline), with a 2 dp accent ring while it has the focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tally_surface" />
            <corners android:radius="@dimen/tally_radius_m" />
            <stroke
                android:width="@dimen/tally_focus_ring_width"
                android:color="@color/tally_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tally_surface" />
            <corners android:radius="@dimen/tally_radius_m" />
            <stroke
                android:width="@dimen/tally_stroke_hairline"
                android:color="@color/tally_outline" />
        </shape>
    </item>
</selector>
