<!-- DiamaneOS Tally colours that are Launcher's own, bound to the system roles as the token
     library's are (the rest come from tallytokens). -->
<resources>
    <!-- A keycap LED's failed ring sits in its dark (onLamp) housing in both themes, so it takes
         the dark theme's error colour: 3:1 or better on the housing, where the light theme's
         error is about 2.6:1. -->
    <color name="tally_keycap_led_failed">@android:color/system_error_dark</color>
</resources>
