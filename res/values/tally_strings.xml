<!-- DiamaneOS Tally: text that stock Launcher3 has no string for (English only for now). -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Label for the keycap icon shape option in the customization picker: a square key with
         rounded corners, DiamaneOS's default icon shape. -->
    <string name="tally_keycap_shape_title">Keycap</string>

    <!-- The state word of an app key whose LED shows a failure (the app posted an error), read by
         screen readers after the app's name: Android's own word, the framework's
         error_message_title. The running state uses app_running_state_description.
         [CHAR LIMIT=30] -->
    <string name="tally_state_failed">Error</string>
    <!-- An app key's accessibility label with its LED's state word: the app's name, then the state.
         For example "Files, Error" or "Clock, Active". -->
    <string name="tally_key_with_state"><xliff:g id="app_name" example="Clock">%1$s</xliff:g>, <xliff:g id="state" example="Active">%2$s</xliff:g></string>

    <!-- Home's tallies band: the key that stands for the live or failed things not shown, which
         opens the notification shade. -->
    <plurals name="tally_more">
        <item quantity="one">+<xliff:g id="count" example="1">%d</xliff:g> more</item>
        <item quantity="other">+<xliff:g id="count" example="3">%d</xliff:g> more</item>
    </plurals>
    <!-- The readout of the "+n more" key: what a tap does. [CHAR LIMIT=12] -->
    <string name="tally_more_show">Show</string>
    <!-- Screen readers' label of the "+n more" key: how many, their names, and what a tap does. -->
    <plurals name="tally_more_description">
        <item quantity="one"><xliff:g id="count" example="1">%1$d</xliff:g> more: <xliff:g id="names" example="Files">%2$s</xliff:g>. Show in the notification shade</item>
        <item quantity="other"><xliff:g id="count" example="2">%1$d</xliff:g> more: <xliff:g id="names" example="Files and Recorder">%2$s</xliff:g>. Show in the notification shade</item>
    </plurals>

    <!-- Home's tallies band, the row under the date that shows what is live now (a timer, a
         recording, a download): its switch in Home settings, and its name for screen readers. A
         long press takes it off Home, as it takes off a widget. [CHAR LIMIT=30] -->
    <string name="tally_home_tallies">Tallies</string>
    <!-- Home settings: the summary of the tallies band's switch. -->
    <string name="tally_home_tallies_summary">What\'s live now, under the date</string>
    <!-- Home settings: the summary of the switch for Home's search slot (the switch's title is
         Launcher's all_apps_search_bar_hint, "Search apps"). -->
    <string name="tally_home_search_summary">Under the dock</string>

    <!-- All apps' letter rail: a screen reader's label for one slot, which jumps to the apps whose
         names start with its letters. The letters are joined as "G or K" (or "T, V, or W") in the
         language's own way. -->
    <string name="tally_rail_slot">Apps starting with <xliff:g id="letters" example="G or K">%1$s</xliff:g></string>
</resources>
