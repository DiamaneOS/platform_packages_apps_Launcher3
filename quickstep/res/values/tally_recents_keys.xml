<!-- Recents' keys in Tally (the OverviewActionButton style: the action keys and Clear all). The
     token library gives the key's shape, colours and type; these two are the prototype's own for
     Recents' smaller keys (design/prototypes/tally/app.css, .rc-keys .key-tonal). -->
<resources>
    <!-- 13 sp words, so three keys fit across the phone. -->
    <dimen name="tally_recents_key_text_size">13sp</dimen>
    <!-- 6 dp between a key's icon and its words. -->
    <dimen name="tally_recents_key_icon_gap">6dp</dimen>
</resources>
