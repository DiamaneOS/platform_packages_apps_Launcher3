<!-- Tally: behind the chip's arrow, the app's name fades into the chip's surface (as stock's
     icon_menu_arrow_background, in the Tally surface and radius). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:autoMirrored="true">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#00000000"
        android:centerX="0.25"
        android:centerColor="@color/tally_surface"
        android:endColor="@color/tally_surface" />
    <corners android:radius="@dimen/tally_radius_s" />
</shape>
